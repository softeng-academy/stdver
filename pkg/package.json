{
    "name":                                 "stdver",
    "publishConfig":                        { "access": "public" },
    "version":                              "0.9.17",
    "stdver":                               "0.9.17-EA",
    "description":                          "Standard Versioning Command-Line Interface",
    "keywords":                             [ "standard", "versioning", "cli", "stdver" ],
    "repository": {
        "type":                             "git",
        "url":                              "git+https://github.com/softeng-academy/stdver.git"
    },
    "author": {
        "name":                             "SEA Software Engineering Academy gGmbH",
        "email":                            "contact@softeng.academy",
        "url":                              "https://softeng.academy"
    },
    "license":                              "MIT",
    "homepage":                             "https://github.com/softeng-academy/stdver",
    "bugs":                                 "https://github.com/softeng-academy/stdver/issues",
    "type":                                 "module",
    "main":                                 "dst/stdver-api.js",
    "module":                               "dst/stdver-api.js",
    "types":                                "dst/stdver-api.d.ts",
    "browser":                              "dst/stdver-api.browser.js",
    "exports": {
        ".": {
            "import":                       { "types": "./dst/stdver-api.d.ts", "default": "./dst/stdver-api.js" },
            "require":                      { "types": "./dst/stdver-api.d.ts", "default": "./dst/stdver-api.js" }
        }
    },
    "bin":                                  { "stdver": "dst/stdver-cli.js" },
    "man":                                  [ "dst/stdver.1", "dst/stdver.3" ],
    "dependencies": {
        "commander":                        "15.0.0",
        "chalk":                            "6.0.0",
        "strip-ansi":                       "7.2.0",
        "moment":                           "2.30.1",
        "cli-table3":                       "0.6.5",
        "globby":                           "16.2.4",
        "tiny-webcrypto":                   "1.0.3",
        "@types/node":                      "26.5.0"
    },
    "devDependencies": {
        "typescript":                       "6.0.3",
        "eslint":                           "10.10.0",
        "@eslint/js":                       "10.0.1",
        "@typescript-eslint/eslint-plugin": "8.70.0",
        "@typescript-eslint/parser":        "8.70.0",
        "typescript-eslint":                "8.70.0",
        "eslint-plugin-promise":            "7.3.0",
        "neostandard":                      "0.14.0-next.1",
        "globals":                          "17.12.0",

        "stmux":                            "2.1.1",
        "@rse/stx":                         "1.1.6",
        "cross-env":                        "10.1.0",
        "nodemon":                          "3.1.14",
        "vite":                             "8.2.2",
        "remark-cli":                       "12.0.1",
        "remark":                           "15.0.1",
        "remark-man":                       "9.0.0",
        "rimraf":                           "6.1.3"
    },
    "allowScripts": {
        "node-pty":                         true
    },
    "engines": {
        "node":                             ">=20.0.0"
    },
    "scripts": {
        "start":                            "stx -v4 -l warning -c etc/stx.conf"
    }
}
